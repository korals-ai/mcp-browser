# Artifacts of ./pre_build.sh. This file travels with the public mirror, where
# there is no repo-root .gitignore to fall back on.
.venv/
__pycache__/
*.pyc
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
# The viewer's local toolchain (npm install in viewer/).
node_modules/
# docker compose's local settings — carries find's API key (.env.example is the template).
.env
# The folder docker compose mounts for the agent's files (kept, contents local).
/work/*
!/work/.gitkeep
